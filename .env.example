# ──────────────────────────────────────────────────────────────
# Civic Mirror — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or .env — they are gitignored.
# ──────────────────────────────────────────────────────────────

# ── Turso / LibSQL ───────────────────────────────────────────
# Production: libsql:// URL from your Turso dashboard
# Local dev:  omit both vars to default to file:dev.db (SQLite)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Used by drizzle-kit for migrations (drizzle.config.ts).
# Set to the same libsql:// URL in production, or a local
# file path like file:dev.db for local development.
DATABASE_URL=

# ── AI / LLM ────────────────────────────────────────────────
# Google Gemini (used by @ai-sdk/google for summarization)
GOOGLE_GENERATIVE_AI_API_KEY=

# Moonshot AI (used by @ai-sdk/moonshotai)
MOONSHOT_API_KEY=

# ── YouTube Data API ────────────────────────────────────────
# v3 API key from Google Cloud Console (used by YouTubeScraper)
YOUTUBE_API_KEY=
